//
// Tenstorrent Executable Definition (TTEX)
//
// This FlatBuffer schema defines the binary format for Tenstorrent HAL
// executables. The compiler backend serializes dispatch metadata into this
// format, and the runtime HAL driver parses it to create executable objects.
//
// The executable_format string for this schema is: "tenstorrent-ttex-fb"
// The file_identifier is "TTEX" (checked by flatcc verify_as_root).
//
// Extension roadmap:
//   Phase A (current): BuiltinProgram enum selects hardcoded PoC programs
//   Phase B: Add ttmetal_kernel_bundle table (kernel source / CB config / core range)
//   Phase C: Add ttnn_op_desc table (op name + attrs + tensor layout)
//   Phase D: Add binary cache hash, profile/trace metadata

namespace iree.tenstorrent.hal;

file_identifier "TTEX";
file_extension "ttex";

// ---------------------------------------------------------------------------
// BuiltinProgram: PoC dispatch routing
// ---------------------------------------------------------------------------
// The runtime driver contains hardcoded TT-Metal program builders for each
// variant. The compiler (or test builder) selects one by enum value.
// This will be superseded by ttnn_op / ttmetal_kernel in later phases.

enum BuiltinProgram : uint32 {
  // custom_sfpi_add kernels (current dispatch_test path)
  CUSTOM_SFPI_ADD = 0,

  // Reserved for single-tile bf16 elementwise add via TTNN API
  TTNN_ELTWISE_ADD = 1,

  // Narrow M1 path: one static 32x32x32 bf16 matmul on a single core.
  BF16_MATMUL_32X32X32 = 2,

  // Correctness-first tiled bf16 matmul path. Static shapes may be encoded
  // in EntryPointDef, and dynamic shapes are supplied via dispatch constants.
  BF16_MATMUL_TILED = 3,
}

// ---------------------------------------------------------------------------
// EntryPointDef: one per HAL export (dispatch function)
// ---------------------------------------------------------------------------
// Fields map directly to iree_hal_executable_export_info_t so the runtime
// can populate that struct without additional computation.

table EntryPointDef {
  // HAL export name (used for ordinal mapping / debug).
  name:string;

  // --- HAL reflection metadata (iree_hal_executable_export_info_t) ---

  // Number of 32-bit push constants expected by this dispatch.
  constant_count:uint16 = 0;

  // Number of buffer bindings expected by this dispatch.
  binding_count:uint16 = 0;

  // iree_hal_executable_export_flags_t (reserved, 0 for now).
  flags:uint64 = 0;

  // Workgroup size [x, y, z]. Scalars with defaults because flatcc
  // does not support default values on struct fields.
  workgroup_size_x:uint32 = 1;
  workgroup_size_y:uint32 = 1;
  workgroup_size_z:uint32 = 1;

  // --- Tenstorrent dispatch routing (Phase A) ---

  builtin:BuiltinProgram = CUSTOM_SFPI_ADD;

  // Static tiled matmul metadata expressed in 32x32 tile counts.
  // These are 0 when the builtin does not use them or when runtime dispatch
  // constants provide the shape dynamically.
  builtin_m_tiles:uint32 = 0;
  builtin_n_tiles:uint32 = 0;
  builtin_k_tiles:uint32 = 0;

  // --- Phase B extension point (TT-Metal JIT) ---
  // ttmetal_kernel:TTMetalKernelBundle;  // kernel source + CB config + core range

  // --- Phase C extension point (TTNN high-level op) ---
  // ttnn_op:TTNNOpDesc;  // op_type + input/output tensor descs + attrs
}

// ---------------------------------------------------------------------------
// ExecutableDef: root table
// ---------------------------------------------------------------------------

table ExecutableDef {
  // Schema version. Keep the default at 0 forever so old blobs with an absent
  // field remain distinguishable. Current serializers explicitly emit v1.
  version:uint32 = 0;

  // One entry per HAL export ordinal.
  entry_points:[EntryPointDef];
}

root_type ExecutableDef;
